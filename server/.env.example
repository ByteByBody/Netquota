# Backend configuration. Copy to .env for local development.
# All variables use the NETQUOTA_ prefix.

# SQLite by default (no Postgres needed for development).
NETQUOTA_DATABASE_URL=sqlite+aiosqlite:///./netquota.db
# PostgreSQL example:
# NETQUOTA_DATABASE_URL=postgresql+psycopg://netquota:password@localhost:5432/netquota

NETQUOTA_ENVIRONMENT=development
NETQUOTA_JWT_SECRET=change-me-at-least-32-random-bytes
NETQUOTA_ADMIN_BOOTSTRAP_USERNAME=admin
NETQUOTA_ADMIN_BOOTSTRAP_PASSWORD=changeme
NETQUOTA_STALE_AFTER_MINUTES=30
NETQUOTA_INTERFACE_POLICY=primary

NETQUOTA_BIND_HOST=127.0.0.1
NETQUOTA_BIND_PORT=8000