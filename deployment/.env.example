# Copy to .env and fill in real secrets before `docker compose up`.

# PostgreSQL
POSTGRES_USER=netquota
POSTGRES_PASSWORD=change-me-strong-postgres-password
POSTGRES_DB=netquota

# Backend
JWT_SECRET=change-me-at-least-32-random-bytes
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-admin-password
STALE_AFTER_MINUTES=30

# Reverse proxy hostname (must match the certificate you configure)
NETQUOTA_DOMAIN=netquota.local